{
  "name": "infrastructure-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run generate:openapi && next build",
    "start": "next start",
    "lint": "next lint --fix",
    "prettier": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "generate:openapi": "ts-node --project scripts/tsconfig.json scripts/generate-openapi.ts",
    "supabase:start": "supabase start  --workdir ./lib",
    "supabase:stop": "supabase stop --workdir ./lib",
    "supabase:db:reset": "supabase db reset --workdir ./lib",
    "supabase:db:diff": "supabase db diff --workdir ./lib",
    "supabase:db:push": "supabase db push --workdir ./lib",
    "test:unit": "vitest run app lib components",
    "test:acceptance": "vitest run __test__/acceptance/tests",
    "test:smoke": "npx playwright test --config=playwright.smoke.config.ts",
    "precommit": "next lint && npm run prettier && npm run test:unit && npm run test:acceptance && npm run test:smoke",
    "test:flakiness-check": "npm run pre-commit && npm run pre-commit && npm run pre-commit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.46.2",
    "@wavesurfer/react": "^1.0.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.2",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "swagger-ui-react": "^5.32.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "unique-names-generator": "^4.7.1",
    "wavesurfer.js": "^7.9.8",
    "zod": "^3.25.56",
    "zod-openapi": "^4.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^16.4.5",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8",
    "prettier": "3.4.2",
    "supabase": "^2.2.1",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
